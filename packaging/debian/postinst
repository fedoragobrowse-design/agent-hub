#!/bin/sh
set -eu
mkdir -p /var/lib/agent-hub
chmod 0750 /var/lib/agent-hub
mkdir -p /etc/agent-hub /var/cache/agent-hub
chmod 0750 /etc/agent-hub /var/cache/agent-hub
if [ ! -e /etc/agent-hub/update.conf ]; then
  install -m 0644 /usr/lib/agent-hub/update.conf /etc/agent-hub/update.conf
fi
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  systemctl enable --now agent-hub-update.timer
fi
echo "Agent Hub installed. Automatic GitHub Release updates are enabled when this package was built by its release workflow." >&2

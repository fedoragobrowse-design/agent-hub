#!/bin/sh
set -eu

PORT="${PORT:-3000}"
URL="http://127.0.0.1:$PORT"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-hub"
LOG_FILE="$STATE_DIR/desktop.log"

mkdir -p "$STATE_DIR"
if ! curl --fail --silent --max-time 1 "$URL" >/dev/null 2>&1; then
  nohup /usr/bin/agent-hub > "$LOG_FILE" 2>&1 &
  attempt=0
  while [ "$attempt" -lt 20 ]; do
    if curl --fail --silent --max-time 1 "$URL" >/dev/null 2>&1; then break; fi
    attempt=$((attempt + 1))
    sleep 1
  done
fi

exec xdg-open "$URL"

#!/bin/sh
set -eu

APP_ROOT=/usr/lib/agent-hub
PORT="${PORT:-3010}"
export PORT
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/agent-hub"
CONFIG="$CONFIG_DIR/environment"
if [ ! -e "$CONFIG" ]; then
  mkdir -p "$CONFIG_DIR"
  install -m 0600 "$APP_ROOT/environment" "$CONFIG"
fi
exec "$APP_ROOT/apps/desktop/node_modules/electron/dist/electron" "$APP_ROOT/apps/desktop"
